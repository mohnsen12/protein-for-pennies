# Copy to .env.local and fill in. NEVER commit the real .env.local.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME=Protein for Pennies

GEMINI_API_KEY=your-gemini-api-key
# Per-model free-tier quota — chain walked automatically on 429s:
GEMINI_TEXT_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash

# Paywall (deferred)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
SESSION_SECRET=long-random-string

GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
